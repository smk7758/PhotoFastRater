<Window x:Class="PhotoFastRater.UI.Views.FolderModeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Photo Fast Rater - フォルダモード" Height="800" Width="1400"
        Background="{DynamicResource MaterialDesignPaper}"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop">

    <Window.InputBindings>
        <KeyBinding Key="Up" Command="{Binding NavigateUpCommand}"/>
        <KeyBinding Key="Down" Command="{Binding NavigateDownCommand}"/>
        <KeyBinding Key="Left" Command="{Binding NavigateLeftCommand}"/>
        <KeyBinding Key="Right" Command="{Binding NavigateRightCommand}"/>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenFolderCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ツールバー -->
        <ToolBar Grid.Row="0" Padding="8">
            <Button Content="フォルダを開く"
                    Command="{Binding OpenFolderCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"/>
            <Separator Margin="8,0"/>
            <ToggleButton Content="ツリー表示"
                         IsChecked="{Binding IsTreeViewMode}"
                         ToolTip="グリッド/ツリー表示を切り替え"
                         Margin="8,0"/>
            <Separator Margin="8,0"/>
            <TextBlock Text="統計:" VerticalAlignment="Center" Margin="8,0"/>
            <TextBlock Text="{Binding RatedPhotos, StringFormat='評価済み: {0}枚'}"
                      VerticalAlignment="Center"
                      Margin="4,0"/>
            <TextBlock Text="{Binding TotalPhotos, StringFormat='/ 合計: {0}枚'}"
                      VerticalAlignment="Center"
                      Margin="4,0"/>
            <Separator Margin="8,0"/>
            <Button Content="セッション保存"
                    Command="{Binding SaveSessionCommand}"
                    Margin="8,0,0,0"/>
            <Button Content="DBに追加"
                    Command="{Binding ExportToDbCommand}"
                    Margin="8,0,0,0"
                    Style="{StaticResource MaterialDesignRaisedButton}"/>
        </ToolBar>

        <!-- メインコンテンツ -->
        <Grid Grid.Row="1" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- 写真グリッド表示 -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                         Visibility="{Binding IsTreeViewMode, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <ItemsControl ItemsSource="{Binding Photos}"
                             VirtualizingPanel.IsVirtualizing="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="200" Height="200" Margin="4"
                                    BorderThickness="2"
                                    Cursor="Hand">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="Gray"/>
                                        <Setter Property="Background" Value="White"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BorderBrush" Value="#2196F3"/>
                                                <Setter Property="Background" Value="#E3F2FD"/>
                                                <Setter Property="BorderThickness" Value="3"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                 Command="{Binding DataContext.SelectPhotoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 CommandParameter="{Binding}"/>
                                    <MouseBinding MouseAction="LeftDoubleClick"
                                                 Command="{Binding DataContext.OpenPhotoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 CommandParameter="{Binding}"/>
                                </Border.InputBindings>
                                <Grid>
                                    <Image Source="{Binding Thumbnail}"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                    <!-- ペアバッジ -->
                                    <Border Background="#CC4CAF50"
                                            CornerRadius="4"
                                            Padding="4,2"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Margin="4"
                                            Visibility="{Binding HasPair, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="{Binding PairBadgeText}"
                                                  Foreground="White"
                                                  FontSize="9"
                                                  FontWeight="Bold"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Bottom"
                                               Background="#80000000"
                                               Margin="4">
                                        <TextBlock Text="{Binding FileName}"
                                                  Foreground="White"
                                                  FontSize="10"
                                                  TextTrimming="CharacterEllipsis"
                                                  Margin="4"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="★"
                                                      Foreground="Yellow"
                                                      FontSize="12"/>
                                            <TextBlock Text="{Binding Rating}"
                                                      Foreground="White"
                                                      FontSize="10"
                                                      Margin="2,0"/>
                                            <TextBlock Text="♥"
                                                      Foreground="Red"
                                                      FontSize="12"
                                                      Margin="8,0,0,0"
                                                      Visibility="{Binding IsFavorite, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- ツリー表示 -->
            <TreeView Grid.Column="0" ItemsSource="{Binding PhotoTree}"
                     Visibility="{Binding IsTreeViewMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding DisplayNameWithCount}" Margin="0,0,8,0"/>
                        </StackPanel>
                        <HierarchicalDataTemplate.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding DisplayNameWithCount}" Margin="0,0,8,0"/>
                                </StackPanel>
                                <HierarchicalDataTemplate.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayNameWithCount}" Margin="0,0,8,0"/>
                                        </StackPanel>
                                        <HierarchicalDataTemplate.ItemTemplate>
                                            <HierarchicalDataTemplate ItemsSource="{Binding Photos}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding DisplayNameWithCount}" Margin="0,0,8,0"/>
                                                </StackPanel>
                                                <HierarchicalDataTemplate.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Width="120" Height="120" Margin="4"
                                                               BorderBrush="Gray" BorderThickness="1"
                                                               Cursor="Hand">
                                                            <Border.InputBindings>
                                                                <MouseBinding MouseAction="LeftDoubleClick"
                                                                             Command="{Binding DataContext.OpenTreePhotoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                             CommandParameter="{Binding}"/>
                                                            </Border.InputBindings>
                                                            <Grid>
                                                                <Image Source="{Binding Thumbnail}"
                                                                      Stretch="Uniform"/>
                                                                <StackPanel VerticalAlignment="Bottom"
                                                                           Background="#80000000">
                                                                    <TextBlock Text="{Binding FileName}"
                                                                              Foreground="White"
                                                                              FontSize="8"
                                                                              TextTrimming="CharacterEllipsis"
                                                                              Margin="2"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </HierarchicalDataTemplate.ItemTemplate>
                                            </HierarchicalDataTemplate>
                                        </HierarchicalDataTemplate.ItemTemplate>
                                    </HierarchicalDataTemplate>
                                </HierarchicalDataTemplate.ItemTemplate>
                            </HierarchicalDataTemplate>
                        </HierarchicalDataTemplate.ItemTemplate>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <!-- サイドパネル -->
            <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1,0,0,0" Padding="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="選択中の写真"
                                  FontSize="16"
                                  FontWeight="Bold"
                                  Margin="0,0,0,8"/>

                        <TextBlock Text="{Binding SelectedPhoto.FileName}"
                                  TextWrapping="Wrap"
                                  Margin="0,0,0,4"/>

                        <!-- エクスプローラーで開く -->
                        <Button Content="エクスプローラーで開く"
                               Command="{Binding OpenPhotoFolderCommand}"
                               Margin="0,0,0,12"
                               HorizontalAlignment="Left"/>

                        <!-- レーティング -->
                        <TextBlock Text="レーティング"
                                  FontWeight="Bold"
                                  Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding SelectedPhoto.Rating, StringFormat='現在: ★{0}'}"
                                  Margin="0,0,0,4"
                                  FontWeight="Bold"
                                  Foreground="#2196F3"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Button Content="0" Command="{Binding SetRatingCommand}" CommandParameter="0" Margin="2"/>
                            <Button Content="1" Command="{Binding SetRatingCommand}" CommandParameter="1" Margin="2"/>
                            <Button Content="2" Command="{Binding SetRatingCommand}" CommandParameter="2" Margin="2"/>
                            <Button Content="3" Command="{Binding SetRatingCommand}" CommandParameter="3" Margin="2"/>
                            <Button Content="4" Command="{Binding SetRatingCommand}" CommandParameter="4" Margin="2"/>
                            <Button Content="5" Command="{Binding SetRatingCommand}" CommandParameter="5" Margin="2"/>
                        </StackPanel>

                        <!-- クイックアクション -->
                        <TextBlock Text="クイックアクション"
                                  FontWeight="Bold"
                                  Margin="0,0,0,4"/>
                        <Button Content="お気に入り"
                               Command="{Binding ToggleFavoriteCommand}"
                               Margin="0,4"/>
                        <Button Content="リジェクト"
                               Command="{Binding ToggleRejectCommand}"
                               Margin="0,4,0,16"/>

                        <!-- ペア情報 -->
                        <TextBlock Text="ペアファイル"
                                  FontWeight="Bold"
                                  Margin="0,0,0,4"
                                  Visibility="{Binding SelectedPhoto.HasPair, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <TextBlock Text="{Binding SelectedPhoto.PairBadgeText}"
                                  Margin="0,2"
                                  Visibility="{Binding SelectedPhoto.HasPair, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <Button Content="ペアファイルを表示"
                               Command="{Binding ShowPairedFileCommand}"
                               Margin="0,4,0,16"
                               Visibility="{Binding SelectedPhoto.HasPair, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <!-- EXIF情報 -->
                        <TextBlock Text="EXIF情報"
                                  FontWeight="Bold"
                                  Margin="0,0,0,8"/>

                        <!-- 撮影日時 -->
                        <StackPanel Margin="0,2">
                            <TextBlock Text="撮影日時" FontSize="10" Foreground="Gray"/>
                            <TextBlock Text="{Binding SelectedPhoto.DateTaken, StringFormat='yyyy/MM/dd HH:mm:ss'}"
                                      TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- カメラ -->
                        <StackPanel Margin="0,4"
                                   Visibility="{Binding SelectedPhoto.CameraModel, Converter={StaticResource NullOrEmptyToCollapsedConverter}}">
                            <TextBlock Text="カメラ" FontSize="10" Foreground="Gray"/>
                            <TextBlock Text="{Binding SelectedPhoto.CameraModel}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- レンズ -->
                        <StackPanel Margin="0,4"
                                   Visibility="{Binding SelectedPhoto.LensModel, Converter={StaticResource NullOrEmptyToCollapsedConverter}}">
                            <TextBlock Text="レンズ" FontSize="10" Foreground="Gray"/>
                            <TextBlock Text="{Binding SelectedPhoto.LensModel}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- 絞り -->
                        <StackPanel Margin="0,4"
                                   Visibility="{Binding SelectedPhoto.Aperture, Converter={StaticResource NullOrEmptyToCollapsedConverter}}">
                            <TextBlock Text="絞り" FontSize="10" Foreground="Gray"/>
                            <TextBlock Text="{Binding SelectedPhoto.Aperture, StringFormat='F{0:0.0}'}"/>
                        </StackPanel>

                        <!-- シャッタースピード -->
                        <StackPanel Margin="0,4"
                                   Visibility="{Binding SelectedPhoto.ShutterSpeed, Converter={StaticResource NullOrEmptyToCollapsedConverter}}">
                            <TextBlock Text="シャッタースピード" FontSize="10" Foreground="Gray"/>
                            <TextBlock Text="{Binding SelectedPhoto.ShutterSpeed}"/>
                        </StackPanel>

                        <!-- ISO -->
                        <StackPanel Margin="0,4"
                                   Visibility="{Binding SelectedPhoto.ISO, Converter={StaticResource NullOrEmptyToCollapsedConverter}}">
                            <TextBlock Text="ISO" FontSize="10" Foreground="Gray"/>
                            <TextBlock Text="{Binding SelectedPhoto.ISO, StringFormat='ISO {0}'}"/>
                        </StackPanel>

                        <!-- 焦点距離 -->
                        <StackPanel Margin="0,4"
                                   Visibility="{Binding SelectedPhoto.FocalLength, Converter={StaticResource NullOrEmptyToCollapsedConverter}}">
                            <TextBlock Text="焦点距離" FontSize="10" Foreground="Gray"/>
                            <TextBlock Text="{Binding SelectedPhoto.FocalLength, StringFormat='{}{0:0}mm'}"/>
                        </StackPanel>

                        <!-- 露出補正 -->
                        <StackPanel Margin="0,4"
                                   Visibility="{Binding SelectedPhoto.ExposureCompensation, Converter={StaticResource NullOrEmptyToCollapsedConverter}}">
                            <TextBlock Text="露出補正" FontSize="10" Foreground="Gray"/>
                            <TextBlock Text="{Binding SelectedPhoto.ExposureCompensation, StringFormat='{}{0:+0.0;-0.0;0}EV'}"/>
                        </StackPanel>

                        <!-- 解像度 -->
                        <StackPanel Margin="0,4,0,8">
                            <TextBlock Text="解像度" FontSize="10" Foreground="Gray"/>
                            <TextBlock>
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} × {1}">
                                        <Binding Path="SelectedPhoto.Width"/>
                                        <Binding Path="SelectedPhoto.Height"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ステータスバー -->
        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding FolderPath}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
