<Window x:Class="PhotoFastRater.UI.Views.FolderModeSettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" Title="フォルダモード設定" Width="600" Height="640" ResizeMode="CanResize" WindowStartupLocation="CenterOwner" Style="{StaticResource MaterialDesignWindow}" Foreground="{DynamicResource DarkroomPaperBrush}">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20">
      <!-- サムネイルサイズ -->
      <TextBlock Text="デフォルトサムネイルサイズ" Style="{StaticResource MaterialDesignSubtitle1TextBlock}" Margin="0,0,0,4" />
      <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
        <Slider x:Name="ThumbnailSlider" Minimum="100" Maximum="600" Value="{Binding DefaultThumbnailSize}" Width="280" VerticalAlignment="Center" AutomationProperties.AutomationId="FolderModeSettingsWindow.ThumbnailSlider" AutomationProperties.Name="サムネイルの大きさ" />
        <TextBlock Text="{Binding DefaultThumbnailSize, StringFormat={}{0}px}" VerticalAlignment="Center" Margin="12,0,0,0" Width="55" />
      </StackPanel>
      <Separator Margin="0,0,0,12" />
      <!-- RAW+JPEGグループ化 -->
      <CheckBox Content="RAW+JPEGを1アイテムにまとめて表示（クリックで展開）" IsChecked="{Binding GroupRawJpeg}" Style="{StaticResource MaterialDesignCheckBox}" Margin="0,0,0,16" AutomationProperties.AutomationId="FolderModeSettingsWindow.GroupRawJpeg" AutomationProperties.Name="RAW+JPEGを1アイテムにまとめて表示（クリックで展開）" />
      <Separator Margin="0,0,0,12" />
      <!-- 写真アイテムのEXIF表示 -->
      <CheckBox Content="写真アイテムの名前欄にEXIF情報を表示" IsChecked="{Binding ShowExifInItem}" x:Name="ShowExifCheckBox" Style="{StaticResource MaterialDesignCheckBox}" Margin="0,0,0,8" AutomationProperties.AutomationId="FolderModeSettingsWindow.ShowExifCheckBox" AutomationProperties.Name="写真アイテムの名前欄にEXIF情報を表示" />
      <StackPanel Margin="24,0,0,16" IsEnabled="{Binding IsChecked, ElementName=ShowExifCheckBox}">
        <CheckBox Content="レンズ名" IsChecked="{Binding ExifShowLens}" Style="{StaticResource MaterialDesignCheckBox}" Margin="0,4" AutomationProperties.AutomationId="FolderModeSettingsWindow.ExifShowLens" AutomationProperties.Name="レンズ名" />
        <CheckBox Content="撮影設定（F値 / シャッタースピード / ISO）" IsChecked="{Binding ExifShowSettings}" Style="{StaticResource MaterialDesignCheckBox}" Margin="0,4" AutomationProperties.AutomationId="FolderModeSettingsWindow.ExifShowSettings" AutomationProperties.Name="撮影設定（F値 / シャッタースピード / ISO）" />
        <CheckBox Content="撮影日時" IsChecked="{Binding ExifShowDate}" Style="{StaticResource MaterialDesignCheckBox}" Margin="0,4" AutomationProperties.AutomationId="FolderModeSettingsWindow.ExifShowDate" AutomationProperties.Name="撮影日時" />
        <CheckBox Content="カメラ機種名" IsChecked="{Binding ExifShowCamera}" Style="{StaticResource MaterialDesignCheckBox}" Margin="0,4" AutomationProperties.AutomationId="FolderModeSettingsWindow.ExifShowCamera" AutomationProperties.Name="カメラ機種名" />
      </StackPanel>
      <Separator Margin="0,0,0,12" />
      <!-- メモリ管理 -->
      <TextBlock Text="メモリ管理" Style="{StaticResource MaterialDesignSubtitle1TextBlock}" Margin="0,0,0,8" />
      <CheckBox Content="メモリ不足時に警告ポップアップを表示" IsChecked="{Binding ShowMemoryWarning}" Style="{StaticResource MaterialDesignCheckBox}" Margin="0,0,0,8" AutomationProperties.AutomationId="FolderModeSettingsWindow.ShowMemoryWarning" AutomationProperties.Name="メモリ不足時に警告ポップアップを表示" />
      <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
        <TextBlock Text="フルイメージメモリ上限:" VerticalAlignment="Center" Margin="0,0,8,0" />
        <Slider Minimum="256" Maximum="4096" Value="{Binding MaxFullImageMemoryMB}" Width="200" VerticalAlignment="Center" AutomationProperties.AutomationId="FolderModeSettingsWindow.MaxFullImageMemoryMB" AutomationProperties.Name="フル画像メモリ上限（MB）" />
        <TextBlock Text="{Binding MaxFullImageMemoryMB, StringFormat={}{0}MB}" VerticalAlignment="Center" Margin="8,0,0,0" Width="60" />
      </StackPanel>
      <!-- メモリ推奨情報 -->
      <StackPanel Margin="0,4,0,16">
        <TextBlock FontSize="12" Foreground="{DynamicResource MaterialDesignBodyLight}">
          <Run Text="システムRAM: " />
          <Run Text="{Binding SystemTotalRamMB, Mode=OneWay, StringFormat={}{0}MB}" />
          <Run Text=" / 推奨設定値: " />
          <Run Text="{Binding RecommendedMaxFullImageMemoryMB, Mode=OneWay, StringFormat={}{0}MB}" />
        </TextBlock>
        <Border Background="#FFFFF9C4" BorderBrush="#FFFFF176" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,4,0,0" Visibility="{Binding IsMemorySettingBelowRecommended,                         Converter={StaticResource BooleanToVisibilityConverter}}">
          <TextBlock Text="現在の設定が推奨値より低い設定です。パフォーマンス向上のため、メモリ割り当てを増やすことを検討してください。" FontSize="12" TextWrapping="Wrap" Foreground="#FF5F4000" />
        </Border>
      </StackPanel>
      <Separator Margin="0,0,0,12" />
      <!-- ボタン -->
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
        <Button Content="設定ファイルを開く (JSON)" Click="OpenSettingsFile_Click" Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,8,0" AutomationProperties.AutomationId="FolderModeSettingsWindow.OpenSettingsFile_Click" />
        <Button Content="キャンセル" Click="Cancel_Click" Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,8,0" AutomationProperties.AutomationId="FolderModeSettingsWindow.Cancel_Click" />
        <Button Content="保存して閉じる" Click="Save_Click" Style="{StaticResource MaterialDesignRaisedButton}" AutomationProperties.AutomationId="FolderModeSettingsWindow.Save_Click" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Window>