<Window x:Class="PhotoFastRater.UI.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:collections="clr-namespace:PhotoFastRater.UI.Collections" xmlns:viewModels="clr-namespace:PhotoFastRater.UI.ViewModels" xmlns:models="clr-namespace:PhotoFastRater.Core.Models;assembly=PhotoFastRater.Core" xmlns:sys="clr-namespace:System;assembly=mscorlib" mc:Ignorable="d" Title="Photo Fast Rater" Height="720" Width="1280" Language="ja-JP" UseLayoutRounding="True" SnapsToDevicePixels="True" AutomationProperties.Name="Photo Fast Rater ライブラリ" Background="{DynamicResource DarkroomInkBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <!-- Two wrapping rows keep the opening and selection workflows visible on small laptops. -->
    <Border Grid.Row="0" Background="{DynamicResource DarkroomSlateBrush}" Padding="10,6">
      <StackPanel>
        <WrapPanel>
          <Button Content="写真をインポート" Command="{Binding ImportFolderCommand}" Style="{StaticResource DarkroomActionButton}" Margin="0,0,6,5" AutomationProperties.AutomationId="MainWindow.ImportFolderCommand" />
          <Button Content="キャンセル" Command="{Binding CancelImportCommand}" Margin="0,0,6,5" AutomationProperties.AutomationId="MainWindow.CancelImportCommand" />
          <Button Content="一覧を更新" Command="{Binding LoadPhotosCommand}" Margin="0,0,6,5" AutomationProperties.AutomationId="MainWindow.LoadPhotosCommand" />
          <Button Content="フォルダを直接開く" Click="OpenFolderMode_Click" Margin="0,0,16,5" AutomationProperties.AutomationId="MainWindow.OpenFolderMode_Click" />
          <Button Content="2枚比較" Tag="2" Click="OpenCompare_Click" Margin="0,0,6,5" AutomationProperties.AutomationId="MainWindow.OpenCompare_Click" />
          <Button Content="3枚比較" Tag="3" Click="OpenCompare_Click" Margin="0,0,6,5" AutomationProperties.AutomationId="MainWindow.OpenCompare_Click.2" />
          <Button Content="4枚比較" Tag="4" Click="OpenCompare_Click" Margin="0,0,6,5" AutomationProperties.AutomationId="MainWindow.OpenCompare_Click.3" />
        </WrapPanel>
        <WrapPanel VerticalAlignment="Center">
          <TextBlock Text="検索" VerticalAlignment="Center" Margin="0,0,8,0" />
          <TextBox Width="210" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="ファイル名・パス・タグを入力（200ms後に検索）" Margin="0,0,12,4" AutomationProperties.AutomationId="MainWindow.SearchText" AutomationProperties.Name="ファイル名・パス・タグを入力（200ms後に検索）" />
          <ToggleButton Content="ツリー表示" IsChecked="{Binding PhotoGrid.IsTreeViewMode}" Margin="0,0,6,4" AutomationProperties.AutomationId="MainWindow.PhotoGrid.IsTreeViewMode" AutomationProperties.Name="ツリー表示" />
          <ToggleButton Content="欠損のみ" IsChecked="{Binding PhotoGrid.MissingOnly, Mode=OneWay}" Command="{Binding PhotoGrid.ToggleMissingOnlyCommand}" Margin="0,0,16,4" AutomationProperties.AutomationId="MainWindow.PhotoGrid.ToggleMissingOnlyCommand" AutomationProperties.Name="欠損のみ" />
          <Button Content="チェック写真にタグ" Command="{Binding AddTagToBatchCommand}" Margin="0,0,6,4" AutomationProperties.AutomationId="MainWindow.AddTagToBatchCommand" />
          <Button Content="チェック写真をコレクションへ" Command="{Binding AddBatchToCollectionCommand}" Margin="0,0,6,4" AutomationProperties.AutomationId="MainWindow.AddBatchToCollectionCommand" />
        </WrapPanel>
      </StackPanel>
    </Border>
    <!-- メインコンテンツ -->
    <TabControl x:Name="WorkspaceTabs" Grid.Row="1" Margin="8">
      <TabItem Header="写真一覧">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="220" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="1" Style="{StaticResource DarkroomPanel}" Padding="12" Margin="10,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <TextBlock Text="選択した写真" Style="{StaticResource DarkroomSectionTitle}" />
                <TextBlock Text="{Binding PhotoGrid.SelectedPhoto.FileName, TargetNullValue='写真をクリックして選択'}" TextWrapping="Wrap" Margin="0,0,0,12" />
                <TextBlock Text="星評価（0～5キー）" Margin="0,0,0,6" />
                <WrapPanel>
                  <Button Content="0" Command="{Binding PhotoGrid.SetRatingCommand}" AutomationProperties.AutomationId="MainWindow.PhotoGrid.SetRatingCommand.0">
                    <Button.CommandParameter>
                      <sys:Int32>0</sys:Int32>
                    </Button.CommandParameter>
                  </Button>
                  <Button Content="1" Command="{Binding PhotoGrid.SetRatingCommand}" AutomationProperties.AutomationId="MainWindow.PhotoGrid.SetRatingCommand.1">
                    <Button.CommandParameter>
                      <sys:Int32>1</sys:Int32>
                    </Button.CommandParameter>
                  </Button>
                  <Button Content="2" Command="{Binding PhotoGrid.SetRatingCommand}" AutomationProperties.AutomationId="MainWindow.PhotoGrid.SetRatingCommand.2">
                    <Button.CommandParameter>
                      <sys:Int32>2</sys:Int32>
                    </Button.CommandParameter>
                  </Button>
                  <Button Content="3" Command="{Binding PhotoGrid.SetRatingCommand}" AutomationProperties.AutomationId="MainWindow.PhotoGrid.SetRatingCommand.3">
                    <Button.CommandParameter>
                      <sys:Int32>3</sys:Int32>
                    </Button.CommandParameter>
                  </Button>
                  <Button Content="4" Command="{Binding PhotoGrid.SetRatingCommand}" AutomationProperties.AutomationId="MainWindow.PhotoGrid.SetRatingCommand.4">
                    <Button.CommandParameter>
                      <sys:Int32>4</sys:Int32>
                    </Button.CommandParameter>
                  </Button>
                  <Button Content="5" Command="{Binding PhotoGrid.SetRatingCommand}" AutomationProperties.AutomationId="MainWindow.PhotoGrid.SetRatingCommand.5">
                    <Button.CommandParameter>
                      <sys:Int32>5</sys:Int32>
                    </Button.CommandParameter>
                  </Button>
                </WrapPanel>
                <TextBlock Text="{Binding PhotoGrid.SelectedPhoto.Rating, StringFormat='星評価: {0}'}" Margin="0,8,0,8" />
                <Button Content="お気に入り切替（F）" Command="{Binding PhotoGrid.ToggleFavoriteCommand}" Margin="0,0,0,6" AutomationProperties.AutomationId="MainWindow.PhotoGrid.ToggleFavoriteCommand" />
                <TextBlock Text="{Binding PhotoGrid.SelectedPhoto.FavoriteStatus}" />
                <Button Content="リジェクト切替（X）" Command="{Binding PhotoGrid.ToggleRejectCommand}" Margin="0,10,0,6" AutomationProperties.AutomationId="MainWindow.PhotoGrid.ToggleRejectCommand" />
                <TextBlock Text="{Binding PhotoGrid.SelectedPhoto.RejectedStatus}" />
                <TextBlock Text="クリック: 1枚を選択・評価&#xA;左上チェック: 一括整理・出力&#xA;矢印: 写真を移動&#xA;Enter: 写真ビューア" TextWrapping="Wrap" Foreground="{DynamicResource DarkroomMutedBrush}" Margin="0,20,0,0" />
              </StackPanel>
            </ScrollViewer>
          </Border>
          <!-- グリッド表示 -->
          <ListBox x:Name="PhotoGridList" ItemsSource="{Binding PhotoGrid.Photos}" SelectedItem="{Binding PhotoGrid.SelectedPhoto}" ScrollViewer.CanContentScroll="True" BorderThickness="0" Background="{DynamicResource DarkroomInkBrush}" Visibility="{Binding PhotoGrid.IsTreeViewMode, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <collections:VirtualizingPhotoPanel ItemSize="{Binding PhotoGrid.ThumbnailSize}" />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Button Width="{Binding DataContext.PhotoGrid.ThumbnailSize, RelativeSource={RelativeSource AncestorType=Window}}" Height="{Binding DataContext.PhotoGrid.ThumbnailSize, RelativeSource={RelativeSource AncestorType=Window}}" Margin="4" BorderThickness="2" Cursor="Hand" Tag="{Binding}" Command="{Binding DataContext.PhotoGrid.SelectPhotoCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding FileName}" AutomationProperties.AutomationId="MainWindow.DataContext.PhotoGrid.SelectPhotoCommand">
                  <Button.Style>
                    <Style TargetType="Button">
                      <Setter Property="BorderBrush" Value="{DynamicResource DarkroomDividerBrush}" />
                      <Setter Property="Background" Value="{DynamicResource DarkroomSlateBrush}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                          <Setter Property="BorderBrush" Value="#F5B642" />
                          <Setter Property="Background" Value="#272C31" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                  <Button.InputBindings>
                    <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding DataContext.PhotoGrid.OpenPhotoCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                  </Button.InputBindings>
                  <Button.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                      <MenuItem Header="レーティング" DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" AutomationProperties.AutomationId="MainWindow.レーティング">
                        <MenuItem Header="★ 0" Tag="0" Click="RatingMenuItem_Click" AutomationProperties.AutomationId="MainWindow.RatingMenuItem_Click" />
                        <MenuItem Header="★ 1" Tag="1" Click="RatingMenuItem_Click" AutomationProperties.AutomationId="MainWindow.RatingMenuItem_Click.2" />
                        <MenuItem Header="★★ 2" Tag="2" Click="RatingMenuItem_Click" AutomationProperties.AutomationId="MainWindow.RatingMenuItem_Click.3" />
                        <MenuItem Header="★★★ 3" Tag="3" Click="RatingMenuItem_Click" AutomationProperties.AutomationId="MainWindow.RatingMenuItem_Click.4" />
                        <MenuItem Header="★★★★ 4" Tag="4" Click="RatingMenuItem_Click" AutomationProperties.AutomationId="MainWindow.RatingMenuItem_Click.5" />
                        <MenuItem Header="★★★★★ 5" Tag="5" Click="RatingMenuItem_Click" AutomationProperties.AutomationId="MainWindow.RatingMenuItem_Click.6" />
                      </MenuItem>
                      <Separator />
                      <MenuItem Header="お気に入り切り替え" Click="ToggleFavorite_Click" AutomationProperties.AutomationId="MainWindow.ToggleFavorite_Click" />
                      <MenuItem Header="リジェクト切り替え" Click="ToggleReject_Click" AutomationProperties.AutomationId="MainWindow.ToggleReject_Click" />
                      <Separator />
                      <MenuItem Header="SNSエクスポート" Click="ExportToSocialMedia_Click" AutomationProperties.AutomationId="MainWindow.ExportToSocialMedia_Click" />
                      <Separator />
                      <MenuItem Header="DBから削除" Click="DeleteFromDatabase_Click" AutomationProperties.AutomationId="MainWindow.DeleteFromDatabase_Click" />
                      <MenuItem Header="ファイルをごみ箱へ移動" Click="DeleteFile_Click" Foreground="Red" AutomationProperties.AutomationId="MainWindow.DeleteFile_Click" />
                    </ContextMenu>
                  </Button.ContextMenu>
                  <Grid>
                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <CheckBox IsChecked="{Binding IsBatchSelected}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="7" Padding="4" ToolTip="一括操作の対象にする" AutomationProperties.AutomationId="MainWindow.IsBatchSelected" AutomationProperties.Name="一括操作の対象にする" />
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Padding="5,2" Background="{DynamicResource RejectRedBrush}" Visibility="{Binding IsMissing, Converter={StaticResource BooleanToVisibilityConverter}}">
                      <TextBlock Text="ファイルなし" Foreground="{DynamicResource DarkroomInkBrush}" FontWeight="SemiBold" FontSize="12" />
                    </Border>
                    <StackPanel VerticalAlignment="Bottom" Background="#80000000" Margin="4">
                      <TextBlock Text="{Binding FileName}" Foreground="White" FontSize="12" TextTrimming="CharacterEllipsis" Margin="4" />
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="★" Foreground="Yellow" FontSize="12" />
                        <TextBlock Text="{Binding Rating}" Foreground="White" FontSize="12" Margin="2,0" />
                      </StackPanel>
                    </StackPanel>
                  </Grid>
                </Button>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <!-- ツリー表示 -->
          <TreeView ItemsSource="{Binding PhotoGrid.PhotoTree}" Visibility="{Binding PhotoGrid.IsTreeViewMode, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.AutomationId="MainWindow.PhotoGrid.PhotoTree">
            <TreeView.ItemTemplate>
              <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding DisplayNameWithCount}" Margin="0,0,8,0" />
                </StackPanel>
                <HierarchicalDataTemplate.ItemTemplate>
                  <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding DisplayNameWithCount}" Margin="0,0,8,0" />
                    </StackPanel>
                    <HierarchicalDataTemplate.ItemTemplate>
                      <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding DisplayNameWithCount}" Margin="0,0,8,0" />
                        </StackPanel>
                        <HierarchicalDataTemplate.ItemTemplate>
                          <HierarchicalDataTemplate ItemsSource="{Binding Photos}">
                            <StackPanel Orientation="Horizontal">
                              <TextBlock Text="{Binding DisplayNameWithCount}" Margin="0,0,8,0" />
                            </StackPanel>
                            <HierarchicalDataTemplate.ItemTemplate>
                              <DataTemplate>
                                <Border Width="150" Height="150" Margin="2" BorderBrush="Gray" BorderThickness="1" Background="White" Cursor="Hand">
                                  <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding DataContext.PhotoGrid.OpenPhotoCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                  </Border.InputBindings>
                                  <Grid>
                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                    <TextBlock Text="{Binding FileName}" Background="#80000000" Foreground="White" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Bottom" Padding="2" />
                                  </Grid>
                                </Border>
                              </DataTemplate>
                            </HierarchicalDataTemplate.ItemTemplate>
                          </HierarchicalDataTemplate>
                        </HierarchicalDataTemplate.ItemTemplate>
                      </HierarchicalDataTemplate>
                    </HierarchicalDataTemplate.ItemTemplate>
                  </HierarchicalDataTemplate>
                </HierarchicalDataTemplate.ItemTemplate>
              </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
        </Grid>
      </TabItem>
      <TabItem Header="タグ／コレクション">
        <Grid Margin="16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Style="{StaticResource DarkroomPanel}" Padding="14">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="タグ" Style="{StaticResource DarkroomSectionTitle}" />
              <ListBox ItemsSource="{Binding Organization.Tags}" DisplayMemberPath="Name" />
            </DockPanel>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource DarkroomPanel}" Padding="14">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock Text="階層コレクション" Style="{StaticResource DarkroomSectionTitle}" />
              <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,0,0,12">
                <TextBox Width="240" Text="{Binding Organization.NewCollectionName, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="コレクション名" AutomationProperties.AutomationId="MainWindow.Organization.NewCollectionName" AutomationProperties.Name="コレクション名" materialDesign:HintAssist.IsFloating="True" materialDesign:HintAssist.FloatingScale="1" />
                <Button Content="ルート作成" Command="{Binding Organization.CreateRootCollectionCommand}" Margin="8,0,0,0" AutomationProperties.AutomationId="MainWindow.Organization.CreateRootCollectionCommand" />
                <Button Content="選択項目の下に作成" Command="{Binding Organization.CreateChildCollectionCommand}" Margin="6,0,0,0" AutomationProperties.AutomationId="MainWindow.Organization.CreateChildCollectionCommand" />
              </StackPanel>
              <TreeView Grid.Row="2" ItemsSource="{Binding Organization.Collections}" SelectedItemChanged="CollectionTree_SelectedItemChanged" AutomationProperties.AutomationId="MainWindow.Organization.Collections">
                <TreeView.ItemTemplate>
                  <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <TextBlock Text="{Binding Name}" />
                  </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
              </TreeView>
              <TextBlock Grid.Row="3" Text="{Binding Organization.StatusText}" Foreground="{DynamicResource DarkroomMutedBrush}" Margin="0,10,0,0" />
            </Grid>
          </Border>
        </Grid>
      </TabItem>
      <TabItem Header="イベント">
        <Grid Margin="16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="420" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" Grid.ColumnSpan="2" Margin="0,0,0,16">
            <TextBox Width="200" Text="{Binding Events.NewEventName, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="イベント名" AutomationProperties.AutomationId="MainWindow.Events.NewEventName" AutomationProperties.Name="イベント名" materialDesign:HintAssist.IsFloating="True" materialDesign:HintAssist.FloatingScale="1" />
            <Button Content="イベント作成" Command="{Binding CreateEventFromSelectionCommand}" Margin="8,0,0,0" AutomationProperties.AutomationId="MainWindow.CreateEventFromSelectionCommand" />
            <Button Content="自動候補を確認" Command="{Binding Events.AutoGroupPhotosCommand}" Margin="8,0,0,0" AutomationProperties.AutomationId="MainWindow.Events.AutoGroupPhotosCommand" />
            <Button Content="候補を確定" Command="{Binding Events.ConfirmAutoGroupsCommand}" Margin="8,0,0,0" AutomationProperties.AutomationId="MainWindow.Events.ConfirmAutoGroupsCommand" />
          </StackPanel>
          <ListBox Grid.Row="1" Grid.Column="0" ItemsSource="{Binding Events.Events}" DisplayMemberPath="Name" />
          <Border Grid.Row="1" Grid.Column="1" Margin="16,0,0,0" Style="{StaticResource DarkroomPanel}" Padding="12">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="{Binding Events.PreviewStatus}" TextWrapping="Wrap" Margin="0,0,0,8" />
              <ListBox ItemsSource="{Binding Events.PreviewCandidates}">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Name}" ToolTip="{Binding Key}" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </Border>
        </Grid>
      </TabItem>
      <TabItem Header="エクスポート">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
          <Grid Margin="16" MaxWidth="1000" HorizontalAlignment="Left">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="エクスポート設定" FontSize="18" FontWeight="Bold" Margin="0,0,0,16" />
            <Grid Grid.Row="1">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="450" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="450" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="単体SNS出力（JPEG）" Style="{StaticResource DarkroomSectionTitle}" />
              <ComboBox Width="180" HorizontalAlignment="Left" SelectedValue="{Binding Export.TargetPlatform}" SelectedValuePath="Tag" Margin="0,6,0,6" AutomationProperties.AutomationId="MainWindow.Export.TargetPlatform" AutomationProperties.Name="単体出力のSNSサイズ">
                <ComboBoxItem Content="Instagram" Tag="{x:Static models:SocialMediaPlatform.Instagram}" />
                <ComboBoxItem Content="Twitter" Tag="{x:Static models:SocialMediaPlatform.Twitter}" />
                <ComboBoxItem Content="Facebook" Tag="{x:Static models:SocialMediaPlatform.Facebook}" />
              </ComboBox>
              <Button Content="選択写真を単体出力…" Command="{Binding ExportSelectedPhotoCommand}" HorizontalAlignment="Left" Margin="0,0,0,12" AutomationProperties.AutomationId="MainWindow.ExportSelectedPhoto" AutomationProperties.Name="選択写真を単体出力" />
                <TextBlock Text="一括出力の形式・命名" Style="{StaticResource DarkroomSectionTitle}" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                  <ComboBox Width="120" SelectedValue="{Binding Export.OutputFormat}" SelectedValuePath="Content" AutomationProperties.AutomationId="MainWindow.Export.OutputFormat" AutomationProperties.Name="Export.OutputFormat">
                    <ComboBoxItem Content="JPEG" />
                    <ComboBoxItem Content="PNG" />
                    <ComboBoxItem Content="TIFF" />
                  </ComboBox>
                  <TextBox Width="220" Margin="8,0,0,0" Text="{Binding Export.FileNamePattern}" materialDesign:HintAssist.Hint="命名規則: {name} {id} {date}" AutomationProperties.AutomationId="MainWindow.Export.FileNamePattern" AutomationProperties.Name="命名規則: {name} {id} {date}" materialDesign:HintAssist.IsFloating="True" materialDesign:HintAssist.FloatingScale="1" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                  <TextBlock Text="JPEG品質" VerticalAlignment="Center" Width="80" />
                  <Slider Width="220" Minimum="1" Maximum="100" Value="{Binding Export.Quality}" AutomationProperties.AutomationId="MainWindow.Export.Quality" AutomationProperties.Name="Export.Quality" />
                  <TextBlock Text="{Binding Export.Quality}" Margin="8,0" VerticalAlignment="Center" />
                </StackPanel>
                <CheckBox Content="元画像のメタデータを出力へ保持" IsChecked="{Binding Export.PreserveMetadata}" Margin="0,8,0,0" AutomationProperties.AutomationId="MainWindow.Export.PreserveMetadata" AutomationProperties.Name="元画像のメタデータを出力へ保持" />
                <TextBlock Text="向き補正・回転・クロップ・リサイズ" Style="{StaticResource DarkroomSectionTitle}" Margin="0,18,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                  <TextBlock Text="回転" Width="50" VerticalAlignment="Center" />
                  <ComboBox Width="100" SelectedValue="{Binding Export.RotationDegrees}" SelectedValuePath="Tag" AutomationProperties.AutomationId="MainWindow.Export.RotationDegrees" AutomationProperties.Name="Export.RotationDegrees">
                    <ComboBoxItem Content="なし">
                      <ComboBoxItem.Tag>
                        <sys:Int32>0</sys:Int32>
                      </ComboBoxItem.Tag>
                    </ComboBoxItem>
                    <ComboBoxItem Content="90°">
                      <ComboBoxItem.Tag>
                        <sys:Int32>90</sys:Int32>
                      </ComboBoxItem.Tag>
                    </ComboBoxItem>
                    <ComboBoxItem Content="180°">
                      <ComboBoxItem.Tag>
                        <sys:Int32>180</sys:Int32>
                      </ComboBoxItem.Tag>
                    </ComboBoxItem>
                    <ComboBoxItem Content="270°">
                      <ComboBoxItem.Tag>
                        <sys:Int32>270</sys:Int32>
                      </ComboBoxItem.Tag>
                    </ComboBoxItem>
                  </ComboBox>
                  <TextBox Width="100" Margin="12,0,0,0" Text="{Binding Export.MaximumWidth, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}" materialDesign:HintAssist.Hint="最大幅" AutomationProperties.AutomationId="MainWindow.Export.MaximumWidth" AutomationProperties.Name="最大幅" materialDesign:HintAssist.IsFloating="True" materialDesign:HintAssist.FloatingScale="1" />
                  <TextBox Width="100" Margin="8,0,0,0" Text="{Binding Export.MaximumHeight, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}" materialDesign:HintAssist.Hint="最大高" AutomationProperties.AutomationId="MainWindow.Export.MaximumHeight" AutomationProperties.Name="最大高" materialDesign:HintAssist.IsFloating="True" materialDesign:HintAssist.FloatingScale="1" />
                </StackPanel>
                <CheckBox Content="非破壊クロップを有効化" IsChecked="{Binding Export.CropEnabled}" Margin="0,10,0,0" AutomationProperties.AutomationId="MainWindow.Export.CropEnabled" AutomationProperties.Name="非破壊クロップを有効化" />
                <StackPanel Orientation="Horizontal" Margin="18,5,0,0">
                  <Button Content="1:1" Command="{Binding Export.ApplyCropPresetCommand}" CommandParameter="1:1" AutomationProperties.AutomationId="MainWindow.Export.ApplyCropPresetCommand.11" />
                  <Button Content="4:3" Command="{Binding Export.ApplyCropPresetCommand}" CommandParameter="4:3" Margin="5,0" AutomationProperties.AutomationId="MainWindow.Export.ApplyCropPresetCommand.43" />
                  <Button Content="3:2" Command="{Binding Export.ApplyCropPresetCommand}" CommandParameter="3:2" AutomationProperties.AutomationId="MainWindow.Export.ApplyCropPresetCommand.32" />
                  <Button Content="16:9" Command="{Binding Export.ApplyCropPresetCommand}" CommandParameter="16:9" Margin="5,0" AutomationProperties.AutomationId="MainWindow.Export.ApplyCropPresetCommand.169" />
                </StackPanel>
                <TextBlock Text="クロップ位置と寸法は画像全体を1とする正規化値です。" FontSize="12" Foreground="{DynamicResource DarkroomMutedBrush}" Margin="18,6,0,0" />
                <StackPanel Orientation="Horizontal" Margin="18,5,0,0" IsEnabled="{Binding Export.CropEnabled}">
                  <TextBox Width="72" Text="{Binding Export.CropX, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}" materialDesign:HintAssist.Hint="X" AutomationProperties.AutomationId="MainWindow.Export.CropX" AutomationProperties.Name="X" materialDesign:HintAssist.IsFloating="True" materialDesign:HintAssist.FloatingScale="1" />
                  <TextBox Width="72" Text="{Binding Export.CropY, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}" materialDesign:HintAssist.Hint="Y" Margin="5,0" AutomationProperties.AutomationId="MainWindow.Export.CropY" AutomationProperties.Name="Y" materialDesign:HintAssist.IsFloating="True" materialDesign:HintAssist.FloatingScale="1" />
                  <TextBox Width="72" Text="{Binding Export.CropWidth, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}" materialDesign:HintAssist.Hint="幅" AutomationProperties.AutomationId="MainWindow.Export.CropWidth" AutomationProperties.Name="幅" materialDesign:HintAssist.IsFloating="True" materialDesign:HintAssist.FloatingScale="1" />
                  <TextBox Width="72" Text="{Binding Export.CropHeight, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}" materialDesign:HintAssist.Hint="高さ" Margin="5,0" AutomationProperties.AutomationId="MainWindow.Export.CropHeight" AutomationProperties.Name="高さ" materialDesign:HintAssist.IsFloating="True" materialDesign:HintAssist.FloatingScale="1" />
                </StackPanel>
                <CheckBox Content="枠を追加" IsChecked="{Binding Export.EnableFrame}" Margin="0,16,0,0" AutomationProperties.AutomationId="MainWindow.Export.EnableFrame" AutomationProperties.Name="枠を追加" />
                <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
                  <TextBlock Text="枠の幅:" VerticalAlignment="Center" />
                  <Slider Width="200" Minimum="10" Maximum="100" Value="{Binding Export.FrameWidth}" IsEnabled="{Binding Export.EnableFrame}" Margin="8,0" AutomationProperties.AutomationId="MainWindow.Export.FrameWidth" AutomationProperties.Name="Export.FrameWidth" />
                  <TextBlock Text="{Binding Export.FrameWidth}" VerticalAlignment="Center" />
                </StackPanel>
                <CheckBox Content="EXIF情報を表示" IsChecked="{Binding Export.EnableExifOverlay}" Margin="0,16,0,0" AutomationProperties.AutomationId="MainWindow.Export.EnableExifOverlay" AutomationProperties.Name="EXIF情報を表示" />
              </StackPanel>
              <Border Grid.Column="2" Style="{StaticResource DarkroomPanel}" Padding="14">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Top" Text="{Binding Export.BatchStatus}" TextWrapping="Wrap" Margin="0,0,0,10" />
                  <WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <Button Content="チェック写真を書き出す" Command="{Binding ExportBatchSelectionCommand}" Style="{StaticResource DarkroomActionButton}" AutomationProperties.AutomationId="MainWindow.ExportBatchSelectionCommand" />
                    <Button Content="キャンセル" Command="{Binding Export.CancelBatchCommand}" Margin="8,0" AutomationProperties.AutomationId="MainWindow.Export.CancelBatchCommand" />
                    <Button Content="失敗だけ再試行" Command="{Binding RetryFailedExportsCommand}" AutomationProperties.AutomationId="MainWindow.RetryFailedExportsCommand" />
                  </WrapPanel>
                  <ListBox ItemsSource="{Binding Export.BatchResults}" />
                </DockPanel>
              </Border>
            </Grid>
          </Grid>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="設定">
        <TabControl Margin="8">
          <!-- キャッシュ設定タブ -->
          <TabItem Header="キャッシュ">
            <ScrollViewer>
              <StackPanel Margin="16" MaxWidth="600" HorizontalAlignment="Left">
                <TextBlock Text="キャッシュ設定" FontSize="18" FontWeight="Bold" Margin="0,0,0,16" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                  <TextBox Width="400" Text="{Binding Settings.CachePath}" IsReadOnly="{Binding Settings.IsCachePathReadOnly}" materialDesign:HintAssist.Hint="キャッシュフォルダ（SSD推奨）" AutomationProperties.AutomationId="MainWindow.Settings.CachePath" AutomationProperties.Name="キャッシュフォルダ（SSD推奨）" materialDesign:HintAssist.IsFloating="True" materialDesign:HintAssist.FloatingScale="1" />
                  <Button Content="参照" Command="{Binding Settings.SelectCachePathCommand}" Margin="8,0,0,0" AutomationProperties.AutomationId="MainWindow.Settings.SelectCachePathCommand" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,16,0,8">
                  <TextBlock Text="メモリキャッシュサイズ (MB):" VerticalAlignment="Center" Width="200" />
                  <Slider Width="200" Minimum="100" Maximum="2000" Value="{Binding Settings.MaxMemoryCacheSizeMB}" TickFrequency="100" IsSnapToTickEnabled="True" AutomationProperties.AutomationId="MainWindow.Settings.MaxMemoryCacheSizeMB" AutomationProperties.Name="Settings.MaxMemoryCacheSizeMB" />
                  <TextBlock Text="{Binding Settings.MaxMemoryCacheSizeMB}" VerticalAlignment="Center" Margin="8,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
                  <TextBlock Text="サムネイルサイズ (px):" VerticalAlignment="Center" Width="200" />
                  <Slider Width="200" Minimum="256" Maximum="1024" Value="{Binding Settings.ThumbnailSize}" TickFrequency="128" IsSnapToTickEnabled="True" AutomationProperties.AutomationId="MainWindow.Settings.ThumbnailSize" AutomationProperties.Name="Settings.ThumbnailSize" />
                  <TextBlock Text="{Binding Settings.ThumbnailSize}" VerticalAlignment="Center" Margin="8,0" />
                </StackPanel>
                <CheckBox Content="RAWファイル対応を有効にする" IsChecked="{Binding Settings.EnableRAWSupport}" Margin="0,16,0,0" AutomationProperties.AutomationId="MainWindow.Settings.EnableRAWSupport" AutomationProperties.Name="RAWファイル対応を有効にする" />
                <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                  <CheckBox Content="GPU描画を使用（再起動後に反映）" IsChecked="{Binding Settings.EnableGPUAcceleration}" Margin="0,12,0,8" AutomationProperties.AutomationId="MainWindow.Settings.EnableGPUAcceleration" />
                  <Button Content="設定を保存" Command="{Binding Settings.SaveSettingsCommand}" Style="{StaticResource MaterialDesignRaisedButton}" AutomationProperties.AutomationId="MainWindow.Settings.SaveSettingsCommand" />
                  <Button Content="キャッシュをクリア" Command="{Binding Settings.ClearCacheCommand}" Margin="8,0,0,0" AutomationProperties.AutomationId="MainWindow.Settings.ClearCacheCommand" />
                </StackPanel>
                <TextBlock Text="{Binding Settings.CurrentCacheSize, StringFormat='現在のキャッシュサイズ: {0:N0} bytes'}" Margin="0,16,0,0" FontSize="12" Foreground="{DynamicResource DarkroomMutedBrush}" />
                <TextBlock Text="{Binding Settings.SaveStatus}" Margin="0,8,0,0" Foreground="{DynamicResource RatingAmberBrush}" TextWrapping="Wrap" />
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <!-- 管理フォルダタブ -->
          <TabItem Header="管理フォルダ">
            <Grid Margin="16">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="200" />
              </Grid.RowDefinitions>
              <!-- フォルダリスト -->
              <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="登録フォルダ一覧" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                <Button Content="フォルダ追加" Command="{Binding Settings.ManagedFolders.AddFolderCommand}" Margin="16,0,0,0" Style="{StaticResource MaterialDesignRaisedButton}" AutomationProperties.AutomationId="MainWindow.Settings.ManagedFolders.AddFolderCommand" />
                <Button Content="削除" Command="{Binding Settings.ManagedFolders.RemoveFolderCommand}" Margin="8,0,0,0" AutomationProperties.AutomationId="MainWindow.Settings.ManagedFolders.RemoveFolderCommand" />
                <Button Content="スキャン" Command="{Binding Settings.ManagedFolders.ScanFolderCommand}" Margin="8,0,0,0" AutomationProperties.AutomationId="MainWindow.Settings.ManagedFolders.ScanFolderCommand" />
                <Button Content="編集を保存" Command="{Binding Settings.ManagedFolders.SaveEditsCommand}" Margin="8,0,0,0" AutomationProperties.AutomationId="MainWindow.Settings.ManagedFolders.SaveEditsCommand" />
                <Button Content="一括スキャン" Command="{Binding Settings.ManagedFolders.ScanAllFoldersCommand}" Margin="8,0,0,0" Style="{StaticResource MaterialDesignRaisedButton}" AutomationProperties.AutomationId="MainWindow.Settings.ManagedFolders.ScanAllFoldersCommand" />
              </StackPanel>
              <DataGrid Grid.Row="1" ItemsSource="{Binding Settings.ManagedFolders.Folders}" SelectedItem="{Binding Settings.ManagedFolders.SelectedFolder}" AutoGenerateColumns="False" CanUserAddRows="False" Margin="0,8,0,8" AutomationProperties.AutomationId="MainWindow.Settings.ManagedFolders.SelectedFolder">
                <DataGrid.Columns>
                  <DataGridCheckBoxColumn Header="有効" Binding="{Binding IsActive}" Width="50" />
                  <DataGridTextColumn Header="フォルダパス" Binding="{Binding FolderPath}" Width="*" IsReadOnly="True" />
                  <DataGridCheckBoxColumn Header="再帰" Binding="{Binding IsRecursive}" Width="50" />
                  <DataGridTextColumn Header="写真数" Binding="{Binding PhotoCount}" Width="80" IsReadOnly="True" />
                  <DataGridTextColumn Header="最終スキャン" Binding="{Binding LastScanDateDisplay}" Width="150" IsReadOnly="True" />
                </DataGrid.Columns>
              </DataGrid>
              <TextBlock Grid.Row="2" Text="{Binding Settings.ManagedFolders.ScanStatus}" FontSize="12" Foreground="{DynamicResource DarkroomMutedBrush}" Margin="0,8" />
              <!-- 除外パターン -->
              <Grid Grid.Row="3">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,8,0,8">
                  <TextBlock Text="除外パターン" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                  <Button Content="パターン追加" Command="{Binding Settings.ManagedFolders.AddPatternCommand}" Margin="16,0,0,0" AutomationProperties.AutomationId="MainWindow.Settings.ManagedFolders.AddPatternCommand" />
                  <Button Content="削除" Command="{Binding Settings.ManagedFolders.RemovePatternCommand}" Margin="8,0,0,0" AutomationProperties.AutomationId="MainWindow.Settings.ManagedFolders.RemovePatternCommand" />
                </StackPanel>
                <DataGrid Grid.Row="1" ItemsSource="{Binding Settings.ManagedFolders.ExclusionPatterns}" SelectedItem="{Binding Settings.ManagedFolders.SelectedPattern}" AutoGenerateColumns="False" CanUserAddRows="False" AutomationProperties.AutomationId="MainWindow.Settings.ManagedFolders.SelectedPattern">
                  <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="有効" Binding="{Binding IsEnabled}" Width="50" />
                    <DataGridTextColumn Header="パターン" Binding="{Binding PatternString}" Width="*" />
                    <DataGridComboBoxColumn Header="タイプ" ItemsSource="{x:Static viewModels:ManagedFoldersViewModel.PatternTypes}" SelectedItemBinding="{Binding Type}" Width="120" />
                    <DataGridTextColumn Header="説明" Binding="{Binding Description}" Width="200" />
                  </DataGrid.Columns>
                </DataGrid>
              </Grid>
            </Grid>
          </TabItem>
        </TabControl>
      </TabItem>
    </TabControl>
    <!-- ステータスバー -->
    <StatusBar Grid.Row="2">
      <StatusBarItem>
        <TextBlock Text="{Binding StatusText}" />
      </StatusBarItem>
      <Separator />
      <StatusBarItem>
        <TextBlock Text="{Binding PhotoGrid.SelectedPhoto.FileName, TargetNullValue='写真未選択'}" />
      </StatusBarItem>
      <StatusBarItem HorizontalAlignment="Right">
        <TextBlock Text="{Binding ImportErrorCount, StringFormat='エラー {0:N0}件'}" Foreground="{DynamicResource RejectRedBrush}" />
      </StatusBarItem>
    </StatusBar>
  </Grid>
</Window>