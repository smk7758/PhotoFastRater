<Window x:Class="PhotoFastRater.UI.Views.PhotoPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="プレビュー - Photo Fast Rater"
        Height="700"
        Width="900"
        ShowInTaskbar="False"
        Background="{DynamicResource MaterialDesignPaper}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ツールバー -->
        <ToolBar Grid.Row="0" Padding="4">
            <ToggleButton x:Name="ExifToggle"
                          Content="EXIF"
                          IsChecked="True"
                          Margin="4,0"
                          Padding="12,6"/>
            <Separator Margin="8,0"/>
            <TextBlock Text="{Binding SelectedPhoto.FileName}"
                       VerticalAlignment="Center"
                       FontSize="13"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="400"/>
        </ToolBar>

        <!-- メインコンテンツ: 写真 + EXIFパネル -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 写真表示 -->
            <Border Grid.Column="0" Background="#FF1A1A1A">
                <Image Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Source="{Binding SelectedPhoto.FullImage}"/>
            </Border>

            <!-- EXIFパネル (トグル表示) -->
            <Border Grid.Column="1"
                    Width="220"
                    BorderBrush="Gray"
                    BorderThickness="1,0,0,0"
                    Padding="8"
                    Visibility="{Binding IsChecked, ElementName=ExifToggle, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="ファイル情報"
                                   FontWeight="Bold"
                                   Margin="0,0,0,8"/>

                        <!-- ファイル名 -->
                        <TextBlock Text="ファイル名"
                                   FontSize="10"
                                   Foreground="Gray"/>
                        <TextBlock Text="{Binding SelectedPhoto.FileName}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"/>

                        <!-- 撮影日時 -->
                        <TextBlock Text="撮影日時"
                                   FontSize="10"
                                   Foreground="Gray"/>
                        <TextBlock Text="{Binding SelectedPhoto.DateTaken, StringFormat='yyyy/MM/dd HH:mm:ss'}"
                                   Margin="0,0,0,8"/>

                        <!-- レーティング -->
                        <TextBlock Text="レーティング"
                                   FontSize="10"
                                   Foreground="Gray"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="★"
                                       Foreground="#FFB300"
                                       FontSize="14"/>
                            <TextBlock Text="{Binding SelectedPhoto.Rating}"
                                       FontSize="14"
                                       Margin="4,0,0,0"/>
                        </StackPanel>

                        <Separator Margin="0,0,0,8"/>
                        <TextBlock Text="撮影情報"
                                   FontWeight="Bold"
                                   Margin="0,0,0,8"/>

                        <!-- カメラ -->
                        <TextBlock Text="カメラ"
                                   FontSize="10"
                                   Foreground="Gray"/>
                        <TextBlock Text="{Binding SelectedPhoto.CameraModel}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"/>

                        <!-- レンズ -->
                        <TextBlock Text="レンズ"
                                   FontSize="10"
                                   Foreground="Gray"/>
                        <TextBlock Text="{Binding SelectedPhoto.LensModel}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"/>

                        <!-- 絞り -->
                        <TextBlock Text="絞り"
                                   FontSize="10"
                                   Foreground="Gray"/>
                        <TextBlock Text="{Binding SelectedPhoto.Aperture, StringFormat='f/{0:0.0}'}"
                                   Margin="0,0,0,8"/>

                        <!-- シャッタースピード -->
                        <TextBlock Text="シャッタースピード"
                                   FontSize="10"
                                   Foreground="Gray"/>
                        <TextBlock Text="{Binding SelectedPhoto.ShutterSpeed}"
                                   Margin="0,0,0,8"/>

                        <!-- ISO -->
                        <TextBlock Text="ISO"
                                   FontSize="10"
                                   Foreground="Gray"/>
                        <TextBlock Text="{Binding SelectedPhoto.ISO, StringFormat='ISO{0}'}"
                                   Margin="0,0,0,8"/>

                        <!-- 焦点距離 -->
                        <TextBlock Text="焦点距離"
                                   FontSize="10"
                                   Foreground="Gray"/>
                        <TextBlock Text="{Binding SelectedPhoto.FocalLength, StringFormat={}{0:0}mm}"
                                   Margin="0,0,0,8"/>

                        <!-- 露出補正 -->
                        <TextBlock Text="露出補正"
                                   FontSize="10"
                                   Foreground="Gray"/>
                        <TextBlock Text="{Binding SelectedPhoto.ExposureCompensation, StringFormat={}{0:+0.0;-0.0;0}}"
                                   Margin="0,0,0,8"/>

                        <!-- 解像度 -->
                        <TextBlock Text="解像度"
                                   FontSize="10"
                                   Foreground="Gray"/>
                        <TextBlock Margin="0,0,0,8">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0} × {1}">
                                    <Binding Path="SelectedPhoto.Width"/>
                                    <Binding Path="SelectedPhoto.Height"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ステータスバー -->
        <Border Grid.Row="2"
                Background="{DynamicResource MaterialDesignToolBarBackground}"
                Padding="8,4">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding SelectedPhoto.FileName}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="500"/>
                <Separator Margin="8,0"/>
                <TextBlock VerticalAlignment="Center">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="★{0}  {1}">
                            <Binding Path="SelectedPhoto.Rating"/>
                            <Binding Path="SelectedPhoto.SettingsSummary"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</Window>
