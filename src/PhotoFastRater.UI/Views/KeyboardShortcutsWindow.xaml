<Window x:Class="PhotoFastRater.UI.Views.KeyboardShortcutsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="キーボードショートカット設定"
        Width="520" Height="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource MaterialDesignWindow}"
        KeyDown="Window_KeyDown">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <DataGrid ItemsSource="{Binding Shortcuts}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="アクション" Binding="{Binding DisplayName}" Width="220"/>
                    <DataGridTextColumn Header="キー" Binding="{Binding KeyDisplay}" Width="150"/>
                    <DataGridTemplateColumn Header="変更" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="変更"
                                        Command="{Binding DataContext.StartCaptureCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Padding="8,2"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </ScrollViewer>

        <!-- キーキャプチャ中の表示 -->
        <Border Grid.Row="1"
                Background="#F5F5F5"
                BorderBrush="#DDD"
                BorderThickness="1"
                Padding="12,10"
                Margin="0,8,0,0"
                Visibility="{Binding IsCapturing, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="{Binding PressedKeyText}"
                       HorizontalAlignment="Center"
                       FontSize="14"
                       Foreground="#333"/>
        </Border>

        <!-- ボタン行 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="デフォルトに戻す"
                    Command="{Binding ResetToDefaultCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Margin="0,0,8,0"/>
            <Button Content="キャンセル"
                    Click="Cancel_Click"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Margin="0,0,8,0"/>
            <Button Content="保存して閉じる"
                    Click="Save_Click"
                    Style="{StaticResource MaterialDesignRaisedButton}"/>
        </StackPanel>
    </Grid>
</Window>
