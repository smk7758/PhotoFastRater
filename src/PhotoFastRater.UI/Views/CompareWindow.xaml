<Window x:Class="PhotoFastRater.UI.Views.CompareWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="写真を比較 - Photo Fast Rater" Width="1280" Height="700" MinWidth="900" MinHeight="600" Background="{DynamicResource DarkroomInkBrush}" KeyDown="Window_KeyDown" Foreground="{DynamicResource DarkroomPaperBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ToolBar Grid.Row="0" Padding="10,6">
      <TextBlock Text="比較" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
      <Separator Margin="10,0" />
      <CheckBox Content="ズームとパンを同期" IsChecked="{Binding SynchronizeViewport}" VerticalAlignment="Center" ToolTip="ON: 全ペインを同じ表示位置へ移動 / OFF: 各ペインを個別操作" AutomationProperties.AutomationId="CompareWindow.SynchronizeViewport" AutomationProperties.Name="ズームとパンを同期" />
      <Button Content="表示をリセット" Command="{Binding ResetViewportCommand}" Margin="12,0,0,0" AutomationProperties.AutomationId="CompareWindow.ResetViewportCommand" />
      <Button Content="次の組" Command="{Binding AdvanceCommand}" Margin="6,0,0,0" ToolTip="固定していないペインを次の写真へ送る" AutomationProperties.AutomationId="CompareWindow.AdvanceCommand" />
      <Separator Margin="10,0" />
      <CheckBox Content="自動送り" IsChecked="{Binding AutoAdvance}" VerticalAlignment="Center" ToolTip="既定はOFF。ONにすると評価後に次の写真へ進みます。" AutomationProperties.AutomationId="CompareWindow.AutoAdvance" AutomationProperties.Name="自動送り" />
    </ToolBar>
    <ItemsControl Grid.Row="1" ItemsSource="{Binding Panes}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Rows="1" Columns="{Binding DataContext.Panes.Count, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border BorderBrush="{DynamicResource DarkroomDividerBrush}" BorderThickness="0,0,1,0" Background="{DynamicResource DarkroomInkBrush}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <ScrollViewer Grid.Row="0" Tag="{Binding}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" ScrollChanged="PaneScrollViewer_ScrollChanged" PreviewMouseWheel="PaneScrollViewer_PreviewMouseWheel" MouseLeftButtonDown="PaneScrollViewer_MouseLeftButtonDown" MouseMove="PaneScrollViewer_MouseMove" MouseLeftButtonUp="PaneScrollViewer_MouseLeftButtonUp" PanningMode="Both">
                <Image Source="{Binding Image}" Stretch="Uniform">
                  <Image.LayoutTransform>
                    <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}" />
                  </Image.LayoutTransform>
                </Image>
              </ScrollViewer>
              <TextBlock Grid.Row="0" Text="画像を読み込み中…" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource DarkroomMutedBrush}" />
              <Border Grid.Row="0" Background="#D0101214" Padding="18" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToCollapsedConverter}}">
                <StackPanel>
                  <TextBlock Text="この写真を表示できません" Foreground="{DynamicResource RejectRedBrush}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding ErrorMessage}" Margin="0,6,0,0" MaxWidth="280" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <Grid Grid.Row="1" Background="{DynamicResource DarkroomSlateBrush}" Margin="0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="10,7">
                  <TextBlock Text="{Binding Photo.FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Foreground="{DynamicResource DarkroomMutedBrush}" FontSize="12">
                    <Run Text="{Binding Zoom, StringFormat={}{0:P0}}" />
                    <Run Text="  評価 " />
                    <Run Text="{Binding Photo.Rating}" />
                  </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Content="1" Tag="1" Click="Rating_Click" Padding="7,3" Margin="1" AutomationProperties.AutomationId="CompareWindow.Rating_Click" />
                  <Button Content="2" Tag="2" Click="Rating_Click" Padding="7,3" Margin="1" AutomationProperties.AutomationId="CompareWindow.Rating_Click.2" />
                  <Button Content="3" Tag="3" Click="Rating_Click" Padding="7,3" Margin="1" AutomationProperties.AutomationId="CompareWindow.Rating_Click.3" />
                  <Button Content="4" Tag="4" Click="Rating_Click" Padding="7,3" Margin="1" AutomationProperties.AutomationId="CompareWindow.Rating_Click.4" />
                  <Button Content="5" Tag="5" Click="Rating_Click" Padding="7,3" Margin="1" AutomationProperties.AutomationId="CompareWindow.Rating_Click.5" />
                </StackPanel>
                <ToggleButton Grid.Column="2" Content="固定" IsChecked="{Binding IsPinned}" Margin="4" Padding="10,4" ToolTip="次の写真へ進めるとき、このペインを残す" AutomationProperties.AutomationId="CompareWindow.DataContext.TogglePinCommand" AutomationProperties.Name="固定" />
                <Button Grid.Column="3" Content="右へ入替" Command="{Binding DataContext.SwapRightCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="4" Padding="10,4" AutomationProperties.AutomationId="CompareWindow.DataContext.SwapRightCommand" />
              </Grid>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <StatusBar Grid.Row="2">
      <StatusBarItem>
        <TextBlock Text="Ctrl＋ホイール: 拡大縮小 / ドラッグまたはスクロール: 移動 / Esc: 閉じる" />
      </StatusBarItem>
      <StatusBarItem HorizontalAlignment="Right">
        <TextBlock Text="{Binding Panes.Count, StringFormat='比較中 {0}枚'}" />
      </StatusBarItem>
    </StatusBar>
  </Grid>
</Window>